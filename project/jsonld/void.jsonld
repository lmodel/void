          "tag": "note_section",
          "value": "6.3",
          "@type": "Annotation"
        }
      ],
      "description": "The dataset that this document's triples belong to, named by its IRI.",
      "comments": [
        "A document names one; a document in two datasets points at a dataset that holds both as subsets."
      ],
      "from_schema": "https://w3id.org/lmodel/void",
      "mappings": [
        "http://rdfs.org/ns/void#inDataset"
      ],
      "slot_uri": "http://rdfs.org/ns/void#inDataset",
      "owner": "DatasetDescription",
      "domain_of": [
        "DatasetDescription"
      ],
      "range": "Dataset",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.+-]*:[^\\s]+$",
      "@type": "SlotDefinition"
    },
