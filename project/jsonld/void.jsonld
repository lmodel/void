    {
      "name": "linkPredicate",
      "definition_uri": "https://w3id.org/lmodel/void/linkPredicate",
      "annotations": [
        {
          "tag": "note_section",
          "value": "5.3",
          "@type": "Annotation"
        }
      ],
      "description": "The property every link of a linkset has as its predicate, such as owl:sameAs.",
      "comments": [
        "A linkset has one; links with two predicates make two linksets."
      ],
      "from_schema": "https://w3id.org/lmodel/void",
      "mappings": [
