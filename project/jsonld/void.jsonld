        }
      ],
      "description": "The dataset at the object end of every link in a linkset, named by its IRI.",
      "from_schema": "https://w3id.org/lmodel/void",
      "mappings": [
        "http://rdfs.org/ns/void#objectsTarget"
      ],
      "is_a": "target",
      "slot_uri": "http://rdfs.org/ns/void#objectsTarget",
      "owner": "Linkset",
      "domain_of": [
