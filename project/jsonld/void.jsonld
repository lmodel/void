  "classes": [
    {
      "name": "Dataset",
      "definition_uri": "https://w3id.org/lmodel/void/Dataset",
      "annotations": [
        {
          "tag": "note_section",
          "value": "1.3",
          "@type": "Annotation"
        }
      ],
      "description": "RDF triples from one provider, gathered under an IRI so that a description can speak of them as a whole.",
      "notes": [
        "The narrow mappings are the Note's own statement (section 6.5) that a SPARQL service description's datasets and graphs are VoID datasets. The broad mapping follows DCAT 3 (sections 1 and 6.2.1), which offers VoID's properties for the statistics of a DCAT dataset whose data is RDF: a DCAT dataset may hold data in any format, and a VoID dataset holds RDF alone."
      ],
      "comments": [
        "A dataset is named by an IRI, and the IRI of another dataset is how a subset, a linkset's target or a description refers to it."
      ],
      "from_schema": "https://w3id.org/lmodel/void",
      "exact_mappings": [
        "void:Dataset"
      ],
      "narrow_mappings": [
        "sd:Dataset",
        "sd:Graph"
      ],
      "broad_mappings": [
        "dcat:Dataset"
      ],
      "slots": [
        "id",
        "title",
        "description",
        "creator",
        "contributor",
        "publisher",
        "source",
        "created",
        "issued",
        "modified",
        "license",
        "subject",
        "homepage",
        "page",
        "feature",
        "sparqlEndpoint",
        "dataDump",
        "uriLookupEndpoint",
        "openSearchDescription",
        "rootResource",
        "exampleResource",
        "uriSpace",
        "uriRegexPattern",
        "vocabulary",
        "subset",
        "classPartition",
        "propertyPartition",
        "triples",
        "entities",
        "classes",
        "properties",
        "distinctSubjects",
        "distinctObjects",
        "documents"
      ],
      "slot_usage": {},
      "class_uri": "http://rdfs.org/ns/void#Dataset",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "Linkset",
      "definition_uri": "https://w3id.org/lmodel/void/Linkset",
      "annotations": [
        {
          "tag": "note_section",
          "value": "1.4",
          "@type": "Annotation"
        }
      ],
      "description": "A dataset of triples that join two datasets: each triple's subject belongs to one of them and its object to the other.",
      "comments": [
        "A linkset links exactly two distinct datasets: the targets, the subjects' target and the objects' target together name two. The validator checks that two are named; tests/test_data.py checks that they differ.",
        "VoID also accepts one target beside one directed target, which together name two datasets. This schema asks for both targets or both directed targets, so such a linkset names the missing one too."
      ],
      "from_schema": "https://w3id.org/lmodel/void",
      "exact_mappings": [
        "void:Linkset"
      ],
      "is_a": "Dataset",
      "slots": [
        "id",
        "title",
        "description",
        "creator",
        "contributor",
        "publisher",
        "source",
        "created",
        "issued",
        "modified",
        "license",
        "subject",
        "homepage",
        "page",
        "feature",
        "sparqlEndpoint",
        "dataDump",
        "uriLookupEndpoint",
        "openSearchDescription",
        "rootResource",
        "exampleResource",
        "uriSpace",
        "uriRegexPattern",
        "vocabulary",
        "subset",
        "classPartition",
        "propertyPartition",
        "triples",
        "entities",
        "classes",
        "properties",
        "distinctSubjects",
        "distinctObjects",
        "documents",
        "Linkset_target",
        "subjectsTarget",
        "objectsTarget",
        "linkPredicate"
      ],
      "slot_usage": {},
      "class_uri": "http://rdfs.org/ns/void#Linkset",
      "any_of": [
        {
          "description": "Two targets, named with target.",
          "slot_conditions": [
            {
              "name": "target",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "The subjects' target and the objects' target.",
          "slot_conditions": [
            {
              "name": "subjectsTarget",
              "required": true,
              "@type": "SlotDefinition"
            },
            {
              "name": "objectsTarget",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "DatasetDescription",
      "definition_uri": "https://w3id.org/lmodel/void/DatasetDescription",
      "annotations": [
        {
          "tag": "note_section",
          "value": "6.2",
          "@type": "Annotation"
        }
      ],
      "description": "A web document, such as a void.ttl file published beside a dataset, that describes one or more datasets.",
      "notes": [
        "The broad mapping is the vocabulary file's own statement that a dataset description is a FOAF document."
      ],
      "from_schema": "https://w3id.org/lmodel/void",
      "exact_mappings": [
        "void:DatasetDescription"
      ],
      "broad_mappings": [
        "foaf:Document"
      ],
      "slots": [
        "id",
        "title",
        "description",
        "creator",
        "created",
        "modified",
        "primaryTopic",
        "topic",
        "inDataset"
      ],
      "slot_usage": {},
      "class_uri": "http://rdfs.org/ns/void#DatasetDescription",
      "any_of": [
        {
          "description": "The one dataset the description is about.",
          "slot_conditions": [
            {
              "name": "primaryTopic",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "The datasets the description is about.",
          "slot_conditions": [
            {
              "name": "topic",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "TechnicalFeature",
      "definition_uri": "https://w3id.org/lmodel/void/TechnicalFeature",
      "annotations": [
        {
          "tag": "note_section",
          "value": "2.6",
          "@type": "Annotation"
        }
      ],
      "description": "A technical property of how a dataset is served, such as an RDF syntax it can be read in or an HTTP feature its server supports.",
      "comments": [
        "W3C names the RDF syntaxes under http://www.w3.org/ns/formats/, such as http://www.w3.org/ns/formats/Turtle; a feature of another kind takes an IRI of its publisher's own."
      ],
      "from_schema": "https://w3id.org/lmodel/void",
      "exact_mappings": [
        "void:TechnicalFeature"
      ],
      "slots": [
        "id",
        "label",
        "comment",
        "seeAlso"
      ],
      "slot_usage": {},
      "class_uri": "http://rdfs.org/ns/void#TechnicalFeature",
      "@type": "ClassDefinition"
    },
    {
      "name": "ClassBasedPartition",
      "definition_uri": "https://w3id.org/lmodel/void/ClassBasedPartition",
      "annotations": [
        {
          "tag": "note_section",
          "value": "4.5",
          "@type": "Annotation"
        }
      ],
      "description": "The slice of a dataset about the members of one class, written inside that dataset, most often to give counts for it.",
      "comments": [
        "VoID gives a partition no class of its own: it is a dataset, usually a blank node. This schema writes it as a value inside its dataset, so it has no IRI, and its class lives in this schema's own namespace. The name follows VoID's phrase for it and differs from the classPartition slot's by more than case, so that their pages are two files on a filesystem that ignores case."
      ],
      "from_schema": "https://w3id.org/lmodel/void",
      "exact_mappings": [
        "void_linkml:ClassBasedPartition"
      ],
      "broad_mappings": [
        "void:Dataset"
      ],
      "slots": [
        "ClassBasedPartition_class",
        "triples",
        "entities",
        "classes",
        "properties",
        "distinctSubjects",
        "distinctObjects",
        "documents",
        "propertyPartition"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/void/ClassBasedPartition",
      "@type": "ClassDefinition"
    },
    {
      "name": "PropertyBasedPartition",
      "definition_uri": "https://w3id.org/lmodel/void/PropertyBasedPartition",
      "annotations": [
        {
          "tag": "note_section",
          "value": "4.5",
          "@type": "Annotation"
        }
      ],
      "description": "The slice of a dataset made of the triples whose predicate is one property, written inside that dataset, most often to give counts for it.",
      "comments": [
        "As for a class partition, VoID gives it no class of its own, and this schema writes it as a value inside its dataset."
      ],
      "from_schema": "https://w3id.org/lmodel/void",
      "exact_mappings": [
        "void_linkml:PropertyBasedPartition"
      ],
      "broad_mappings": [
        "void:Dataset"
      ],
      "slots": [
        "PropertyBasedPartition_property",
        "triples",
        "entities",
        "classes",
        "properties",
        "distinctSubjects",
        "distinctObjects",
        "documents"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/void/PropertyBasedPartition",
      "@type": "ClassDefinition"
    }
  ],
