@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
<https://w3id.org/lmodel/void/ClassBasedPartition> a linkml:ClassDefinition ;
	skos:broadMatch "void:Dataset"^^xsd:anyURI ;
	skos:exactMatch "void_linkml:ClassBasedPartition"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:note "VoID gives a partition no class of its own: it is a dataset, usually a blank node. This schema writes it as a value inside its dataset, so it has no IRI, and its class lives in this schema's own namespace. The name follows VoID's phrase for it and differs from the classPartition slot's by more than case, so that their pages are two files on a filesystem that ignores case." ;
	linkml:annotations _:c14n19 ;
	linkml:class_uri "https://w3id.org/lmodel/void/ClassBasedPartition"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/void/ClassBasedPartition"^^xsd:anyURI ;
	linkml:description "The slice of a dataset about the members of one class, written inside that dataset, most often to give counts for it." ;
	linkml:slot_usage _:c14n72 ;
	linkml:slots <https://w3id.org/lmodel/void/ClassBasedPartition_class> , <https://w3id.org/lmodel/void/classes> , <https://w3id.org/lmodel/void/distinctObjects> , <https://w3id.org/lmodel/void/distinctSubjects> , <https://w3id.org/lmodel/void/documents> , <https://w3id.org/lmodel/void/entities> , <https://w3id.org/lmodel/void/properties> , <https://w3id.org/lmodel/void/propertyPartition> , <https://w3id.org/lmodel/void/triples> .
<https://w3id.org/lmodel/void/ClassBasedPartition_class> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:mappingRelation "http://rdfs.org/ns/void#class"^^xsd:anyURI ;
	skos:prefLabel "class" ;
	linkml:annotations _:c14n7 ;
	linkml:definition_uri "https://w3id.org/lmodel/void/class"^^xsd:anyURI ;
	linkml:description "The class whose instances a class partition describes, named by its IRI, such as foaf:Person." ;
	linkml:domain <https://w3id.org/lmodel/void/ClassBasedPartition> ;
	linkml:domain_of <https://w3id.org/lmodel/void/ClassBasedPartition> ;
	linkml:is_a <https://w3id.org/lmodel/void/class> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/void/ClassBasedPartition> ;
	linkml:pattern "^[A-Za-z_][A-Za-z0-9_.+-]*:[^\\s]+$" ;
	linkml:range <https://w3id.org/lmodel/void/uriorcurie> ;
	linkml:required true ;
	linkml:slot_uri "http://rdfs.org/ns/void#class"^^xsd:anyURI ;
	linkml:usage_slot_name "class" .
<https://w3id.org/lmodel/void/Dataset> a linkml:ClassDefinition ;
	skos:broadMatch "dcat:Dataset"^^xsd:anyURI ;
	skos:editorialNote "The narrow mappings are the Note's own statement (section 6.5) that a SPARQL service description's datasets and graphs are VoID datasets. The broad mapping follows DCAT 3 (sections 1 and 6.2.1), which offers VoID's properties for the statistics of a DCAT dataset whose data is RDF: a DCAT dataset may hold data in any format, and a VoID dataset holds RDF alone." ;
	skos:exactMatch "void:Dataset"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:narrowMatch "sd:Dataset"^^xsd:anyURI , "sd:Graph"^^xsd:anyURI ;
	skos:note "A dataset is named by an IRI, and the IRI of another dataset is how a subset, a linkset's target or a description refers to it." ;
	linkml:annotations _:c14n74 ;
	linkml:class_uri "http://rdfs.org/ns/void#Dataset"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/void/Dataset"^^xsd:anyURI ;
	linkml:description "RDF triples from one provider, gathered under an IRI so that a description can speak of them as a whole." ;
	linkml:slot_usage _:c14n43 ;
	linkml:slots <https://w3id.org/lmodel/void/classPartition> , <https://w3id.org/lmodel/void/classes> , <https://w3id.org/lmodel/void/contributor> , <https://w3id.org/lmodel/void/created> , <https://w3id.org/lmodel/void/creator> , <https://w3id.org/lmodel/void/dataDump> , <https://w3id.org/lmodel/void/description> , <https://w3id.org/lmodel/void/distinctObjects> , <https://w3id.org/lmodel/void/distinctSubjects> , <https://w3id.org/lmodel/void/documents> , <https://w3id.org/lmodel/void/entities> , <https://w3id.org/lmodel/void/exampleResource> , <https://w3id.org/lmodel/void/feature> , <https://w3id.org/lmodel/void/homepage> , <https://w3id.org/lmodel/void/id> , <https://w3id.org/lmodel/void/issued> , <https://w3id.org/lmodel/void/license> , <https://w3id.org/lmodel/void/modified> , <https://w3id.org/lmodel/void/openSearchDescription> , <https://w3id.org/lmodel/void/page> , <https://w3id.org/lmodel/void/properties> , <https://w3id.org/lmodel/void/propertyPartition> , <https://w3id.org/lmodel/void/publisher> , <https://w3id.org/lmodel/void/rootResource> , <https://w3id.org/lmodel/void/source> , <https://w3id.org/lmodel/void/sparqlEndpoint> , <https://w3id.org/lmodel/void/subject> , <https://w3id.org/lmodel/void/subset> , <https://w3id.org/lmodel/void/title> , <https://w3id.org/lmodel/void/triples> , <https://w3id.org/lmodel/void/uriLookupEndpoint> , <https://w3id.org/lmodel/void/uriRegexPattern> , <https://w3id.org/lmodel/void/uriSpace> , <https://w3id.org/lmodel/void/vocabulary> ;
	linkml:tree_root true .
<https://w3id.org/lmodel/void/DatasetDescription> a linkml:ClassDefinition ;
	skos:broadMatch "foaf:Document"^^xsd:anyURI ;
	skos:editorialNote "The broad mapping is the vocabulary file's own statement that a dataset description is a FOAF document." ;
	skos:exactMatch "void:DatasetDescription"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	linkml:annotations _:c14n6 ;
	linkml:any_of _:c14n31 , _:c14n51 ;
	linkml:class_uri "http://rdfs.org/ns/void#DatasetDescription"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/void/DatasetDescription"^^xsd:anyURI ;
	linkml:description "A web document, such as a void.ttl file published beside a dataset, that describes one or more datasets." ;
	linkml:slot_usage _:c14n24 ;
	linkml:slots <https://w3id.org/lmodel/void/created> , <https://w3id.org/lmodel/void/creator> , <https://w3id.org/lmodel/void/description> , <https://w3id.org/lmodel/void/id> , <https://w3id.org/lmodel/void/inDataset> , <https://w3id.org/lmodel/void/modified> , <https://w3id.org/lmodel/void/primaryTopic> , <https://w3id.org/lmodel/void/title> , <https://w3id.org/lmodel/void/topic> .
<https://w3id.org/lmodel/void/Linkset> a linkml:ClassDefinition ;
	skos:exactMatch "void:Linkset"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:note "A linkset links exactly two distinct datasets: the targets, the subjects' target and the objects' target together name two. The validator checks that two are named; tests/test_data.py checks that they differ." , "VoID also accepts one target beside one directed target, which together name two datasets. This schema asks for both targets or both directed targets, so such a linkset names the missing one too." ;
	linkml:annotations _:c14n25 ;
	linkml:any_of _:c14n41 , _:c14n9 ;
	linkml:class_uri "http://rdfs.org/ns/void#Linkset"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/void/Linkset"^^xsd:anyURI ;
	linkml:description "A dataset of triples that join two datasets: each triple's subject belongs to one of them and its object to the other." ;
	linkml:is_a <https://w3id.org/lmodel/void/Dataset> ;
	linkml:slot_usage _:c14n3 ;
	linkml:slots <https://w3id.org/lmodel/void/Linkset_target> , <https://w3id.org/lmodel/void/classPartition> , <https://w3id.org/lmodel/void/classes> , <https://w3id.org/lmodel/void/contributor> , <https://w3id.org/lmodel/void/created> , <https://w3id.org/lmodel/void/creator> , <https://w3id.org/lmodel/void/dataDump> , <https://w3id.org/lmodel/void/description> , <https://w3id.org/lmodel/void/distinctObjects> , <https://w3id.org/lmodel/void/distinctSubjects> , <https://w3id.org/lmodel/void/documents> , <https://w3id.org/lmodel/void/entities> , <https://w3id.org/lmodel/void/exampleResource> , <https://w3id.org/lmodel/void/feature> , <https://w3id.org/lmodel/void/homepage> , <https://w3id.org/lmodel/void/id> , <https://w3id.org/lmodel/void/issued> , <https://w3id.org/lmodel/void/license> , <https://w3id.org/lmodel/void/linkPredicate> , <https://w3id.org/lmodel/void/modified> , <https://w3id.org/lmodel/void/objectsTarget> , <https://w3id.org/lmodel/void/openSearchDescription> , <https://w3id.org/lmodel/void/page> , <https://w3id.org/lmodel/void/properties> , <https://w3id.org/lmodel/void/propertyPartition> , <https://w3id.org/lmodel/void/publisher> , <https://w3id.org/lmodel/void/rootResource> , <https://w3id.org/lmodel/void/source> , <https://w3id.org/lmodel/void/sparqlEndpoint> , <https://w3id.org/lmodel/void/subject> , <https://w3id.org/lmodel/void/subjectsTarget> , <https://w3id.org/lmodel/void/subset> , <https://w3id.org/lmodel/void/title> , <https://w3id.org/lmodel/void/triples> , <https://w3id.org/lmodel/void/uriLookupEndpoint> , <https://w3id.org/lmodel/void/uriRegexPattern> , <https://w3id.org/lmodel/void/uriSpace> , <https://w3id.org/lmodel/void/vocabulary> .
<https://w3id.org/lmodel/void/Linkset_target> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:mappingRelation "http://rdfs.org/ns/void#target"^^xsd:anyURI ;
	skos:note "Linkset makes it a list of two. The slot itself stays single-valued, so that subjectsTarget and objectsTarget, its narrower slots, inherit one value each." ;
	skos:prefLabel "target" ;
	linkml:annotations _:c14n13 ;
	linkml:definition_uri "https://w3id.org/lmodel/void/target"^^xsd:anyURI ;
	linkml:description "Either dataset a linkset joins, named by its IRI." ;
	linkml:domain <https://w3id.org/lmodel/void/Linkset> ;
	linkml:domain_of <https://w3id.org/lmodel/void/Linkset> ;
	linkml:is_a <https://w3id.org/lmodel/void/target> ;
	linkml:is_usage_slot true ;
	linkml:maximum_cardinality 2 ;
	linkml:minimum_cardinality 2 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/void/Linkset> ;
	linkml:pattern "^[A-Za-z_][A-Za-z0-9_.+-]*:[^\\s]+$" ;
	linkml:range <https://w3id.org/lmodel/void/Dataset> ;
	linkml:slot_uri "http://rdfs.org/ns/void#target"^^xsd:anyURI ;
	linkml:usage_slot_name "target" .
<https://w3id.org/lmodel/void/PropertyBasedPartition> a linkml:ClassDefinition ;
	skos:broadMatch "void:Dataset"^^xsd:anyURI ;
	skos:exactMatch "void_linkml:PropertyBasedPartition"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:note "As for a class partition, VoID gives it no class of its own, and this schema writes it as a value inside its dataset." ;
	linkml:annotations _:c14n69 ;
	linkml:class_uri "https://w3id.org/lmodel/void/PropertyBasedPartition"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/void/PropertyBasedPartition"^^xsd:anyURI ;
	linkml:description "The slice of a dataset made of the triples whose predicate is one property, written inside that dataset, most often to give counts for it." ;
	linkml:slot_usage _:c14n34 ;
	linkml:slots <https://w3id.org/lmodel/void/PropertyBasedPartition_property> , <https://w3id.org/lmodel/void/classes> , <https://w3id.org/lmodel/void/distinctObjects> , <https://w3id.org/lmodel/void/distinctSubjects> , <https://w3id.org/lmodel/void/documents> , <https://w3id.org/lmodel/void/entities> , <https://w3id.org/lmodel/void/properties> , <https://w3id.org/lmodel/void/triples> .
<https://w3id.org/lmodel/void/PropertyBasedPartition_property> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:mappingRelation "http://rdfs.org/ns/void#property"^^xsd:anyURI ;
	skos:prefLabel "property" ;
	linkml:annotations _:c14n22 ;
	linkml:definition_uri "https://w3id.org/lmodel/void/property"^^xsd:anyURI ;
	linkml:description "The property whose triples a property partition holds, named by its IRI, such as foaf:name." ;
	linkml:domain <https://w3id.org/lmodel/void/PropertyBasedPartition> ;
	linkml:domain_of <https://w3id.org/lmodel/void/PropertyBasedPartition> ;
	linkml:is_a <https://w3id.org/lmodel/void/property> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/void/PropertyBasedPartition> ;
	linkml:pattern "^[A-Za-z_][A-Za-z0-9_.+-]*:[^\\s]+$" ;
	linkml:range <https://w3id.org/lmodel/void/uriorcurie> ;
	linkml:required true ;
	linkml:slot_uri "http://rdfs.org/ns/void#property"^^xsd:anyURI ;
	linkml:usage_slot_name "property" .
<https://w3id.org/lmodel/void/TechnicalFeature> a linkml:ClassDefinition ;
	skos:exactMatch "void:TechnicalFeature"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:note "W3C names the RDF syntaxes under http://www.w3.org/ns/formats/, such as http://www.w3.org/ns/formats/Turtle; a feature of another kind takes an IRI of its publisher's own." ;
	linkml:annotations _:c14n57 ;
	linkml:class_uri "http://rdfs.org/ns/void#TechnicalFeature"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/void/TechnicalFeature"^^xsd:anyURI ;
	linkml:description "A technical property of how a dataset is served, such as an RDF syntax it can be read in or an HTTP feature its server supports." ;
	linkml:slot_usage _:c14n48 ;
	linkml:slots <https://w3id.org/lmodel/void/comment> , <https://w3id.org/lmodel/void/id> , <https://w3id.org/lmodel/void/label> , <https://w3id.org/lmodel/void/seeAlso> .
<https://w3id.org/lmodel/void/boolean> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"." ;
	skos:exactMatch "schema:Boolean"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Bool" ;
	linkml:definition_uri "https://w3id.org/linkml/Boolean"^^xsd:anyURI ;
	linkml:description "A binary (true or false) value" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "bool" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI .
<https://w3id.org/lmodel/void/class> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:mappingRelation "http://rdfs.org/ns/void#class"^^xsd:anyURI ;
	linkml:annotations _:c14n42 ;
	linkml:definition_uri "https://w3id.org/lmodel/void/class"^^xsd:anyURI ;
	linkml:description "The class whose instances a class partition describes, named by its IRI, such as foaf:Person." ;
	linkml:domain_of <https://w3id.org/lmodel/void/ClassBasedPartition> ;
	linkml:owner <https://w3id.org/lmodel/void/ClassBasedPartition> ;
	linkml:pattern "^[A-Za-z_][A-Za-z0-9_.+-]*:[^\\s]+$" ;
	linkml:range <https://w3id.org/lmodel/void/uriorcurie> ;
	linkml:slot_uri "http://rdfs.org/ns/void#class"^^xsd:anyURI .
<https://w3id.org/lmodel/void/classPartition> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:mappingRelation "http://rdfs.org/ns/void#classPartition"^^xsd:anyURI ;
	skos:note "VoID makes it a narrower subset; here it is a value, so it does not inherit subset's range." ;
	linkml:annotations _:c14n16 ;
	linkml:definition_uri "https://w3id.org/lmodel/void/classPartition"^^xsd:anyURI ;
	linkml:description "The dataset's slice for one class, given inside it." ;
	linkml:domain_of <https://w3id.org/lmodel/void/Dataset> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/void/Dataset> ;
	linkml:range <https://w3id.org/lmodel/void/ClassBasedPartition> ;
	linkml:slot_uri "http://rdfs.org/ns/void#classPartition"^^xsd:anyURI .
<https://w3id.org/lmodel/void/classes> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:mappingRelation "http://rdfs.org/ns/void#classes"^^xsd:anyURI ;
	linkml:annotations _:c14n73 ;
	linkml:definition_uri "https://w3id.org/lmodel/void/classes"^^xsd:anyURI ;
	linkml:description "How many distinct classes the dataset's rdf:type triples name." ;
	linkml:domain_of <https://w3id.org/lmodel/void/ClassBasedPartition> , <https://w3id.org/lmodel/void/Dataset> , <https://w3id.org/lmodel/void/PropertyBasedPartition> ;
	linkml:minimum_value "0"^^linkml:\@id ;
	linkml:owner <https://w3id.org/lmodel/void/PropertyBasedPartition> ;
	linkml:range <https://w3id.org/lmodel/void/integer> ;
	linkml:slot_uri "http://rdfs.org/ns/void#classes"^^xsd:anyURI .
<https://w3id.org/lmodel/void/comment> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:mappingRelation "http://www.w3.org/2000/01/rdf-schema#comment"^^xsd:anyURI ;
	linkml:annotations _:c14n61 ;
	linkml:definition_uri "https://w3id.org/lmodel/void/comment"^^xsd:anyURI ;
	linkml:description "A sentence or two about the feature." ;
	linkml:domain_of <https://w3id.org/lmodel/void/TechnicalFeature> ;
	linkml:owner <https://w3id.org/lmodel/void/TechnicalFeature> ;
	linkml:range <https://w3id.org/lmodel/void/string> ;
	linkml:slot_uri "http://www.w3.org/2000/01/rdf-schema#comment"^^xsd:anyURI .
<https://w3id.org/lmodel/void/contributor> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:mappingRelation "http://purl.org/dc/terms/contributor"^^xsd:anyURI ;
	linkml:annotations _:c14n21 ;
	linkml:definition_uri "https://w3id.org/lmodel/void/contributor"^^xsd:anyURI ;
	linkml:description "The IRI of an agent that added to the dataset without being its main maker." ;
	linkml:domain_of <https://w3id.org/lmodel/void/Dataset> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/void/Dataset> ;
	linkml:range <https://w3id.org/lmodel/void/uri> ;
	linkml:slot_uri "http://purl.org/dc/terms/contributor"^^xsd:anyURI .
<https://w3id.org/lmodel/void/created> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:mappingRelation "http://purl.org/dc/terms/created"^^xsd:anyURI ;
	linkml:annotations _:c14n5 ;
	linkml:definition_uri "https://w3id.org/lmodel/void/created"^^xsd:anyURI ;
	linkml:description "The date the dataset or document was made." ;
	linkml:domain_of <https://w3id.org/lmodel/void/Dataset> , <https://w3id.org/lmodel/void/DatasetDescription> ;
	linkml:owner <https://w3id.org/lmodel/void/DatasetDescription> ;
	linkml:range <https://w3id.org/lmodel/void/date> ;
	linkml:slot_uri "http://purl.org/dc/terms/created"^^xsd:anyURI .
<https://w3id.org/lmodel/void/creator> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:mappingRelation "http://purl.org/dc/terms/creator"^^xsd:anyURI ;
	linkml:annotations _:c14n50 ;
	linkml:definition_uri "https://w3id.org/lmodel/void/creator"^^xsd:anyURI ;
	linkml:description "The IRI of the agent, human or not, that chiefly made the dataset or document." ;
	linkml:domain_of <https://w3id.org/lmodel/void/Dataset> , <https://w3id.org/lmodel/void/DatasetDescription> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/void/DatasetDescription> ;
	linkml:range <https://w3id.org/lmodel/void/uri> ;
	linkml:slot_uri "http://purl.org/dc/terms/creator"^^xsd:anyURI .
<https://w3id.org/lmodel/void/curie> dcterms:conformsTo "https://www.w3.org/TR/curie/" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations this MUST be expanded to a URI" , "in non-RDF serializations MAY be serialized as the compact representation" ;
	linkml:base "Curie" ;
	linkml:definition_uri "https://w3id.org/linkml/Curie"^^xsd:anyURI ;
	linkml:description "a compact URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/void/dataDump> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/void"^^xsd:anyURI ;
	skos:mappingRelation "http://rdfs.org/ns/void#dataDump"^^xsd:anyURI ;
	skos:note "A page that links to downloads is not a dump; give it as a page instead." ;
	linkml:annotations _:c14n49 ;
	linkml:definition_uri "https://w3id.org/lmodel/void/dataDump"^^xsd:anyURI ;
	linkml:description "A downloadable RDF file holding all of the dataset or a share of it." ;
	linkml:domain_of <https://w3id.org/lmodel/void/Dataset> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/void/Dataset> ;
	linkml:range <https://w3id.org/lmodel/void/uri> ;
	linkml:slot_uri "http://rdfs.org/ns/void#dataDump"^^xsd:anyURI .
<https://w3id.org/lmodel/void/date> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\"." , "URI is dateTime because OWL reasoners don't work with straight date or time" ;
